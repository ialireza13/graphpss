# Full experiment plan. <run_name> <seed> [overrides]  or  ! <command>. Runs top to bottom.
# Main split: 30%-identity sequence clusters (data/splits/cluster30_seed0.json).

# P. Preliminary go/no-go (~6 h GPU). CPU baselines (contact rule, GBT, spectral) run
#    alongside it outside the queue. Decision questions:
#    - does a GNN beat the local-contact GBT baseline on the homology-aware split?
#    - how much accuracy does the random split add (leakage)?
#    12 epochs each; the paper-scale runs come later and do not reuse these.
prelim_gatv2      0  model.conv=gatv2 model.layers=2 model.hidden=512 model.heads=4 train.max_epochs=12 train.patience=4
prelim_gcn        0  model.conv=gcn model.layers=2 model.hidden=2048 train.max_epochs=12 train.patience=4
prelim_egcn_k2    0  model.conv=expanded_gcn model.hops=2 model.layers=2 model.hidden=2048 train.max_epochs=12 train.patience=4 train.workers=16
prelim_mlp_pos    0  model.conv=mlp model.fc_layers=3 model.hidden=2048 train.max_epochs=12 train.patience=4
prelim_gcn_randsplit 0  model.conv=gcn model.layers=2 model.hidden=2048 train.max_epochs=12 train.patience=4 data.split=data/splits/seed0.json
! python scripts/summarize.py
prelim_gatv2_randsplit 0  model.conv=gatv2 model.layers=2 model.hidden=512 model.heads=4 train.max_epochs=12 train.patience=4 data.split=data/splits/seed0.json
! python scripts/summarize.py
# P2. Added after the first results: GATv2 at 84.0% test sat below the local-contact GBT
#     (86.4%), which sees sequence separation directly. Give GATv2 edge features for the
#     separation j - i (clipped at 16), with and without the absolute index embedding.
prelim_gatv2_relpos 0  model.conv=gatv2 model.layers=2 model.hidden=512 model.heads=4 model.rel_pos=16 train.max_epochs=12 train.patience=4
prelim_gatv2_relonly 0  model.conv=gatv2 model.layers=2 model.hidden=512 model.heads=4 model.rel_pos=16 model.pos_enc=none train.max_epochs=12 train.patience=4
! python scripts/summarize.py
# relonly collapsed to the majority class: with identical node inputs GATv2 (edge features
# only in attention) keeps every node identical. contacts = node input summed from the
prelim_gatv2_contacts 0  model.conv=gatv2 model.layers=2 model.hidden=512 model.heads=4 model.rel_pos=16 model.pos_enc=contacts train.max_epochs=12 train.patience=4

# 1. Hyperparameter sweep: 25% of training proteins, 10 epochs, selection on val acc.
#    All rows use the base.yaml input (contact separations, rel_pos 16), chosen after P2:
#    prelim_gatv2_contacts reached 90.7% test against 84.0% with the absolute index.
#    Width 2048 matches PSS-net (4 heads x 512); width 512 is the old baseline setting.
sweep_gatv2_L2_w512 0 model.conv=gatv2 model.layers=2 model.hidden=128 model.heads=4 train.train_fraction=0.25 train.max_epochs=10 train.patience=4 train.eval_train=false
sweep_gatv2_L2_w2048 0 model.conv=gatv2 model.layers=2 model.hidden=512 model.heads=4 train.train_fraction=0.25 train.max_epochs=10 train.patience=4 train.eval_train=false
