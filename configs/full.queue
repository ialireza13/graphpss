# B. Ablations (seed 0): the original absolute-index input instead of contact separations
gatv2_abspos 0 model.conv=gatv2 model.pos_enc=learned model.hidden=128 model.layers=4 model.heads=4 model.fc_layers=1 model.hops=1 model.rel_pos=0 train.max_epochs=20 train.patience=5
