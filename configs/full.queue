# Same models on the random (non-homology) split, to measure leakage
pssnet_gatv2_randsplit 0 model.conv=gatv2 model.pos_enc=contacts model.hidden=128 model.layers=4 model.heads=4 model.fc_layers=1 model.hops=1 model.rel_pos=16 train.max_epochs=20 train.patience=5 data.split=data/splits/seed0.json
